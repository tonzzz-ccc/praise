# Where the frontend sends its API requests.
# Leave EMPTY (recommended) to call /api on the same origin and let the Vite dev server proxy it
# to the backend. This is how other PCs reach the app: open http://<this-pc-ip>:5173 and the proxy
# handles the rest, with no CORS needed.
# Set it to the backend's URL only if you serve the frontend without the Vite proxy, e.g.:
#   VITE_API_URL=http://192.168.0.5:5050
# (then also set CORS_ORIGINS and HOST=0.0.0.0 in backend/.env). Use the same host IP for both so
# the SameSite=Strict session cookie is sent.
VITE_API_URL=

# Backend that the Vite dev proxy forwards /api to (dev only; used by vite.config.js).
# Defaults to http://127.0.0.1:5050.
# PRAISE_API_URL=http://127.0.0.1:5050
