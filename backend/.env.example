PORT=5050
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# PRAISE and EMIS share one database. The app connects here. It holds EMIS's own tables
# (users, reference_sections, ...) and PRAISE's praise_* tables. Created/updated by npm run setup-db.
DB_NAME=emis
# Kept for compatibility; normally the same as DB_NAME.
EMIS_DB_NAME=emis
# Only used by the one-time migration (npm run migrate): the old, separate PRAISE schema to
# copy data from. Ignore if PRAISE never had its own database.
PRAISE_DB_NAME=praise
# Network interface the backend listens on. Default (this PC only) is safe and all that the Vite
# proxy needs. Set HOST=0.0.0.0 to accept direct connections from other PCs on the LAN.
HOST=127.0.0.1
# Frontend origins allowed to call the API directly, comma-separated. Only needed when the frontend
# does NOT go through the Vite proxy (i.e. VITE_API_URL points straight at this backend). No
# wildcard: the session cookie is sent with credentials, so each exact origin must be listed.
# Use the same host IP for the frontend and backend so the SameSite=Strict cookie is sent.
CORS_ORIGINS=http://localhost:5173,http://192.168.0.5:5173
# mysqldump for the backup script (npm run backup-db). Default below suits MySQL 9.7 on Windows.
# MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 9.7\bin\mysqldump.exe
# Built-in Admin account. It stays off until these are changed from the placeholders.
# Keep these here and never as VITE_ variables, which are sent to the browser.
# Put the password in quotes if it contains a # character. Restart the backend after changing them.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
